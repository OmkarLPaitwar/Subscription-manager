{
  "version": 2,
  "name": "subsync-ai",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/build",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://subsync-ai-api.onrender.com/api/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.(js|css|map|ico|png|jpg|jpeg|svg|woff|woff2|ttf|eot|json))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "REACT_APP_API_URL": "https://subsync-ai-api.onrender.com/api"
  }
}
