{
  "version": 2,
  "name": "subsync-ai",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/create-react-app"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/client/static/$1" },
    { "src": "/([^/]+\\.[^/]+)$", "dest": "/client/$1" },
    { "src": "/(.*)", "dest": "/client/index.html" }
  ],
  "env": {
    "REACT_APP_API_URL": "https://subsync-ai-api.onrender.com/api"
  }
}
